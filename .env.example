NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# Optional alias if a tool still emits the old name. Publishable key wins.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Required for checkout + Paymob webhook writes.
# New dashboard: API Keys → Secret keys (`sb_secret_…`)
SUPABASE_SECRET_KEY=
# Optional alias for the legacy JWT service_role key
# SUPABASE_SERVICE_ROLE_KEY=

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
# Transaction Inquiry only (POST /api/auth/tokens)
PAYMOB_API_KEY=
